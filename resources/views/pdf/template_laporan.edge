<html>
  <head>
    <style>
      .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      
      .header h1 {
        font-size: 32px;
        font-weight: bold;
        text-transform: uppercase;
      }
      
      .header span {
        font-size: 24px;
        font-weight: 600;
        text-transform: uppercase;
      }
      
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
      }
      
      th,
      td {
        border: 1px solid #000;
        padding: 8px;
        text-align: center;
      }
      
      th {
        background-color: #f2f2f2;
        font-weight: bold;
      }
    </style>
    <body>
      <div class="header">
        <h1>
          {{ title }}
        </h1>
        <span>Periode : {{date}}</span>
      </div>
      <table>
        <tr>
          <th>
            {{ namaColumn }}
          </th>
          <th>
            {{ transaksiMasukColumn }}
          </th>
          <th>
            {{ transaksiKeluarColumn }}
          </th>
          <th>
            Adjustment Masuk
          </th>
          <th>
            Adjustment Keluar
          </th>
        </tr>
        @each(item in data)
          <tr>
            <td>
              {{ item.nama }}
            </td>
            <td>
              {{ item.masuk }} {{ item.satuan }}
            </td>
            <td>
              {{ item.keluar }} {{ item.type === 'bahan_baku' ? item.satuan : '' }}
            </td>
            <td>
              {{ item.adjustment_masuk }} {{ item.satuan }}
            </td>
            <td>
              {{ item.adjustment_keluar }} {{ item.satuan }}
            </td>
          </tr>
        @endeach
      </table>
    </body>
  </head>
</html>
